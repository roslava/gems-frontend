# Browser requests use the Vite /api proxy by default. Set this only for a public API origin in deployment.
# VITE_API_BASE_URL=https://api.example.org
# Local backend for the development proxy:
API_PROXY_TARGET=http://localhost:8080
# Public object storage URL, matching the backend YC_S3_PUBLIC_URL (no credentials):
VITE_CDN_BASE_URL=https://storage.yandexcloud.net/your-public-bucket
